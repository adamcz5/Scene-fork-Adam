    "update.install.alert.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scene will quit, install the update, and relaunch automatically. Your workspaces, layouts, settings, and Accessibility permission are preserved."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Scene 會 quit、自動裝新版本、然後重開。你嘅 workspaces、layouts、設定，連埋 Accessibility 授權都會保留。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "Scene 將會結束、自動安裝新版本、然後重新啟動。您的 workspaces、layouts、設定，以及 Accessibility 授權都會保留。"
          }
        }
      }
    },
