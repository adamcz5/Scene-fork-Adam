      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "%.1fs" } }
      }
    },
    "interaction.spotlight.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "After you stop switching windows for the delay below, everything except the active window dims and blurs. Switching to a window that is already visible keeps the dim; clicking anywhere else clears it instantly. Works on the windowed desktop only — not full-screen apps or Spaces. Requires Accessibility permission." } }
      }
    },
    "interaction.spotlight.subsection.experimental": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "EXPERIMENTAL" } }
      }
