    "layouts.freeform.canvas_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag a slot to move it, or its edges to resize independently. Slots can overlap — select one to bring it to front, send it to back, or delete it."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "拖曳一格可以郁佢，拖邊框就可以獨立調整大細。格可以重疊 — 揀一格就可以擺上層、擺落底，或者刪除。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "拖曳一格即可移動，拖曳邊框可獨立調整大小。格可以重疊 — 選取一格即可移到最上層、移到最後方，或刪除。"
          }
        }
      }
    },
