    "about.diagnostics.confirm.disable.title": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Stop logging and delete?" } },
        "zh-HK": { "stringUnit": { "state": "translated", "value": "停止紀錄同埋刪晒？" } },
