    "about.diagnostics.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Enable diagnostic logging" } },
        "zh-HK": { "stringUnit": { "state": "translated", "value": "開啟診斷紀錄" } },
        "zh-TW": { "stringUnit": { "state": "translated", "value": "啟用診斷紀錄" } }
