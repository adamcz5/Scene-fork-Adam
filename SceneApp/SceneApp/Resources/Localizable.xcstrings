    },
    "interaction.spotlight.scope.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "\"All of the active app\" keeps every visible window of that app undimmed, not just the one you clicked." } }
      }
    },
    "interaction.spotlight.subsection.monitors": {
