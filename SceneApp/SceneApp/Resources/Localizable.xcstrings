    "interaction.spotlight.exclusion_mode.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "\"One app per monitor\" keeps each display's own last-active window undimmed at the same time — e.g. Slack stays visible on monitor 1 while you're focused on Chrome on monitor 2. \"One app, anywhere\" keeps just a single exclusion everywhere, so every other monitor fully dims." } }
      }
    },
