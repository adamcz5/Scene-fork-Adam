    "about.tips.title": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Tips & Tricks" } }
      }
    },
    "about.tips.title_matching.title": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Two windows of the same app" } }
      }
    },
    "about.tips.title_matching.body": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Running two Chrome profiles? When you assign an app to a zone (Workspaces) or add it to the ⌥Tab switcher (Interaction), fill in “Window title contains” — e.g. “Work” or “Personal”. Scene then picks the window whose title matches, so each one lands in the right place." } }
      }
    },
    "about.tips.overlap.title": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Overlapping layouts" } }
      }
    },
    "about.tips.overlap.body": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "In the layout editor, slots can sit on top of each other — the one later in the list is in front. Select a slot to drag its edges, and use Bring to Front / Send to Back to change the stacking." } }
      }
    },
    "about.tips.dim.title": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Dim" } }
      }
    },
    "about.tips.dim.body": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Turn Dim on from the menu bar or with its shortcut. “Per monitor” keeps one window visible on every display; off keeps just one overall. Switching to a window that is already visible won’t flash the dim." } }
      }
    },
    "about.tips.displays.title": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "More than one display" } }
      }
    },
    "about.tips.displays.body": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "In a workspace, pick a layout for each display and assign apps to its zones. A layout set to “Apply to every display” tiles all screens at once when fired directly." } }
      }
    },
    "about.tips.free_mode.title": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Free Mode" } }
      }
    },
    "about.tips.free_mode.body": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Pause all of Scene’s automatic behavior from the menu bar when you need windows to stay exactly where you put them." } }
      }
    },
