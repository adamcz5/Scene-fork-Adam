    "about.diagnostics.export.disabled.help": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Enable diagnostic logging first." } },
        "zh-HK": { "stringUnit": { "state": "translated", "value": "要先開咗診斷紀錄。" } },
        "zh-TW": { "stringUnit": { "state": "translated", "value": "請先啟用診斷紀錄。" } }
