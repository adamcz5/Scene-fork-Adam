    },
    "about.diagnostics.toggle.help": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Logs orchestration events locally for bug reports. No data leaves your Mac unless you export." } },
        "zh-HK": { "stringUnit": { "state": "translated", "value": "喺本機紀錄低運作事件以便日後報 bug。除非你自己 export，否則啲資料唔會離開你部 Mac。" } },
        "zh-TW": { "stringUnit": { "state": "translated", "value": "在本機紀錄運作事件以便日後回報問題。除非你主動匯出，否則資料不會離開你的 Mac。" } }
      }
    },
    "about.diagnostics.export.button": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Export Diagnostics for Bug Report" } },
        "zh-HK": { "stringUnit": { "state": "translated", "value": "匯出診斷紀錄畀 bug 報告用" } },
        "zh-TW": { "stringUnit": { "state": "translated", "value": "匯出診斷紀錄供問題回報" } }
      }
    },
