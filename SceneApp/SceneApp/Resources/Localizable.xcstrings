      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "One app, anywhere" } }
      }
    },
    "interaction.spotlight.exclusion_mode.per_monitor": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "One app per monitor" } }
      }
