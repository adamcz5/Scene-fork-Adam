    "interaction.spotlight.section.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Darkens and blurs everything except whatever you're actively working in, so the rest of the screen stops competing for attention." } }
      }
    },
