      }
    },
    "interaction.spotlight.dim_browser_chrome.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Re-darkens just the tab strip, address bar, and bookmark bar inside an undimmed Chrome/Chromium-based browser window, so only the page content stays fully visible. Heuristic and best-effort — recognizes Chrome, Edge, Brave, Arc, and Vivaldi; does nothing (safely) in Safari, Firefox, or any other app." } }
      }
    },
